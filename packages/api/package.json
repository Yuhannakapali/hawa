{
  "name": "@hawa/api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@hawa/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "dev": "tsx watch --tsconfig tsconfig.lib.json --conditions=@hawa/source src/main.ts",
    "start": "node dist/main.js",
    "db:seed": "tsx --tsconfig tsconfig.lib.json --conditions=@hawa/source src/db/seed.ts",
    "db:migrate": "tsx --tsconfig tsconfig.lib.json --conditions=@hawa/source src/db/migrate.ts"
  },
  "dependencies": {
    "@hawa/contracts": "*",
    "@hawa/scoring": "^0.0.1",
    "fastify": "^5.12.7",
    "firebase-admin": "^14.5.0",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "tslib": "^2.3.0",
    "typeorm": "^1.1.2",
    "web-push": "^4.0.0"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "@types/web-push": "^3.6.4",
    "tsx": "^4.23.15"
  },
  "nx": {
    "name": "api"
  }
}
